# PetOS Environment Variables Template

# Development Environment (development | production)
ENVIRONMENT=development

# Internal API URL (For Server-Side fetching inside docker network)
API_INTERNAL_URL=http://api:8000
# Public API URL (For browser client-side fetching or localhost direct fetching)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Container Hostnames
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_HOST=redis
REDIS_PORT=6379

# Database Configuration (For API Container)
DATABASE_URL=postgresql+asyncpg://petos:petos_dev_password@postgres:5432/petos_db

# Local Database Configuration (For running outside Docker, e.g. localhost)
LOCAL_DATABASE_URL=postgresql+asyncpg://petos:petos_dev_password@localhost:5432/petos_db

# Redis Configuration (For API Container)
REDIS_PASSWORD=petos_redis_password
REDIS_URL=redis://:petos_redis_password@redis:6379/0

# Local Redis Configuration (For running outside Docker, e.g. localhost)
LOCAL_REDIS_URL=redis://:petos_redis_password@localhost:6379/0

# API Configuration
LOG_LEVEL=info
